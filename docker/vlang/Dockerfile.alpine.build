# Builder image with alpine base, used as the builder stage
# for multi-stage builds. Also the base for the full dev image.

ARG USER=thevlang
FROM ${USER}/vlang:alpine-base

LABEL org.opencontainers.image.title="thevlang/vlang:alpine-build"
LABEL org.opencontainers.image.source=https://github.com/vlang/docker
LABEL org.opencontainers.image.licenses=MIT

WORKDIR /opt/vlang

RUN apk --no-cache add \
    git \
    openssh-client \
    nodejs \
    npm \
    make \
    musl-dev \
    valgrind \
    clang \
    gcc \
    gc \
    gc-dev \
    libx11-dev \
    glfw-dev \
    freetype-dev \
    upx

