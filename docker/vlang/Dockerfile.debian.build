# Builder image with debian base, used as the builder stage
# for multi-stage builds. Also the base for the full dev image.

ARG USER=thevlang
FROM ${USER}/vlang:debian-base AS builder

LABEL org.opencontainers.image.title="thevlang/vlang:debian-build"
LABEL org.opencontainers.image.source=https://github.com/vlang/docker
LABEL org.opencontainers.image.licenses=MIT

WORKDIR /opt/vlang

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        openssh-client \
        clang \
        llvm-dev \
        valgrind \
        make \
        libx11-dev \
        libglfw3-dev \
        libfreetype6-dev \
        wget \
        ca-certificates && \
    # Get NodeJS setup script
    wget -qO- "http://deb.nodesource.com/setup_18.x" | sh - && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        nodejs && \
    apt-get clean && rm -rf /var/cache/apt/archives/* && \
    rm -rf /var/lib/apt/lists/*

