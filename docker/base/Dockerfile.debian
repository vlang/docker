# This is the dockerfile for generating base images for debian
# contains the minimal dependencies needed for V to run
FROM debian:12

LABEL org.opencontainers.image.source=https://github.com/vlang/docker
LABEL org.opencontainers.image.title="thevlang/vlang:debian-base"

WORKDIR /opt/vlang

ENV VVV /opt/vlang
ENV PATH /opt/vlang:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN mkdir -p /opt/vlang && ln -s /opt/vlang/v /usr/bin/v

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive && \
    # Default base dependencies
    apt-get install -y --no-install-recommends libssl-dev libsqlite3-dev && \
    apt-get clean && rm -rf /var/cache/apt/archives/* && \
    rm -rf /var/lib/apt/lists/*

